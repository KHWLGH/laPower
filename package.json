{
  "name": "lapower",
  "version": "0.3.0",
  "private": true,
  "author": "KHWLGH",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "node tools/showcase/server.mjs",
    "build:app": "tauri build",
    "version:set": "node scripts/set-version.mjs",
    "release:prepare": "node scripts/changelog.mjs",
    "release:notes": "node scripts/release.mjs notes",
    "test": "node --test \"test/*.test.js\"",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "build": "node scripts/build-dist.mjs",
    "build:dist": "node scripts/build-dist.mjs --minify",
    "check": "npm test && npm run typecheck && npm run lint",
    "check:rust": "npm run build && cargo fmt --check --all && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "check:all": "npm run check && npm run components:check && npm run check:rust",
    "components:generate": "node scripts/third-party-components.mjs",
    "components:check": "node scripts/third-party-components.mjs --check",
    "clean": "node scripts/clean.mjs clean",
    "clean:incremental": "node scripts/clean.mjs incremental",
    "clean:build": "node scripts/clean.mjs build",
    "clean:all": "node scripts/clean.mjs all",
    "bench:core": "node bench/core.mjs",
    "bench:gate": "node bench/core.mjs --compare",
    "bench:extrema": "node bench/extrema.mjs",
    "bench:memory": "node bench/memory.mjs",
    "bench:startup": "node bench/startup.mjs",
    "bench:packaging": "node bench/packaging.mjs",
    "showcase:dev": "node tools/showcase/server.mjs",
    "showcase:capture": "node tools/showcase/capture.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@tauri-apps/cli": "2.12.1",
    "esbuild": "^0.25.10",
    "playwright": "^1.58.2",
    "typescript": "^5.8.2"
  }
}
